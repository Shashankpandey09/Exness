# Database Configuration
DATABASE_URL=postgresql://trading_user:trading_password@localhost:5432/trading_db

# JWT Secret Key (generate a strong random string for production)
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# Resend API Key for sending magic link emails
RESEND_API_KEY=re_xxxxxxxx

# Base URL for magic link redirects
BASE_URL=http://localhost:3000

# Redis URL
REDIS_URL=redis://localhost:6379

# Server Port
PORT=3000
